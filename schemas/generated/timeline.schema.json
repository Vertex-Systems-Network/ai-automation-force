{
  "$defs": {
    "AuditFields": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "updated_at"
      ],
      "title": "AuditFields",
      "type": "object"
    },
    "TimelineTrack": {
      "additionalProperties": false,
      "properties": {
        "item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Item Ids",
          "type": "array"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "muted": {
          "default": false,
          "title": "Muted",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "track_id": {
          "pattern": "^TRK-[0-9]{6,20}$",
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "kind",
        "name"
      ],
      "title": "TimelineTrack",
      "type": "object"
    }
  },
  "$id": "urn:ai-automation-force:schema:v1:timeline",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "act_ids": {
      "items": {
        "pattern": "^ACT-[0-9]{6,20}$",
        "type": "string"
      },
      "title": "Act Ids",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/AuditFields"
    },
    "duration_seconds": {
      "maximum": 10800,
      "minimum": 60,
      "title": "Duration Seconds",
      "type": "number"
    },
    "fps": {
      "default": 24,
      "exclusiveMinimum": 0,
      "maximum": 120,
      "title": "Fps",
      "type": "number"
    },
    "marker_asset_ids": {
      "items": {
        "pattern": "^AST-[0-9]{6,20}$",
        "type": "string"
      },
      "title": "Marker Asset Ids",
      "type": "array"
    },
    "otio_asset_id": {
      "anyOf": [
        {
          "pattern": "^AST-[0-9]{6,20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Otio Asset Id"
    },
    "project_id": {
      "pattern": "^PRJ-[0-9]{6,20}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "timeline_id": {
      "pattern": "^TML-[0-9]{6,20}$",
      "title": "Timeline Id",
      "type": "string"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/TimelineTrack"
      },
      "title": "Tracks",
      "type": "array"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "timeline_id",
    "project_id",
    "duration_seconds",
    "audit"
  ],
  "title": "Timeline",
  "type": "object"
}
