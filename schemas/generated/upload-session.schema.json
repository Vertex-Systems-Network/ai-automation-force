{
  "$defs": {
    "AuditFields": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "updated_at"
      ],
      "title": "AuditFields",
      "type": "object"
    },
    "StorageBackend": {
      "enum": [
        "filesystem",
        "s3"
      ],
      "title": "StorageBackend",
      "type": "string"
    },
    "UploadMode": {
      "enum": [
        "single",
        "multipart"
      ],
      "title": "UploadMode",
      "type": "string"
    },
    "UploadPart": {
      "additionalProperties": false,
      "properties": {
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        },
        "etag": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag"
        },
        "part_number": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Part Number",
          "type": "integer"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "part_number",
        "size_bytes",
        "recorded_at"
      ],
      "title": "UploadPart",
      "type": "object"
    },
    "UploadSessionStatus": {
      "enum": [
        "open",
        "uploading",
        "completed",
        "aborted",
        "expired"
      ],
      "title": "UploadSessionStatus",
      "type": "string"
    }
  },
  "$id": "urn:ai-automation-force:schema:v1:upload-session",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable transfer state. Completion means uploaded, not quarantine/Asset acceptance.",
  "properties": {
    "aborted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aborted At"
    },
    "audit": {
      "$ref": "#/$defs/AuditFields"
    },
    "backend": {
      "$ref": "#/$defs/StorageBackend"
    },
    "backend_upload_id": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend Upload Id"
    },
    "bucket": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bucket"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "creation_idempotency_key": {
      "maxLength": 200,
      "minLength": 8,
      "title": "Creation Idempotency Key",
      "type": "string"
    },
    "expected_mime_type": {
      "maxLength": 255,
      "minLength": 3,
      "title": "Expected Mime Type",
      "type": "string"
    },
    "expected_size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Expected Size Bytes",
      "type": "integer"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/UploadMode"
    },
    "object_key": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Object Key",
      "type": "string"
    },
    "observed_etag": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Etag"
    },
    "observed_size_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Size Bytes"
    },
    "observed_version_id": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Version Id"
    },
    "original_filename": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Filename"
    },
    "part_size_bytes": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Part Size Bytes"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/UploadPart"
      },
      "title": "Parts",
      "type": "array"
    },
    "project_id": {
      "pattern": "^PRJ-[0-9]{6,20}$",
      "title": "Project Id",
      "type": "string"
    },
    "quota_reservation_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quota Reservation Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/UploadSessionStatus",
      "default": "open"
    },
    "storage_object_id": {
      "pattern": "^STO-[0-9]{6,20}$",
      "title": "Storage Object Id",
      "type": "string"
    },
    "upload_session_id": {
      "pattern": "^UPS-[0-9]{6,20}$",
      "title": "Upload Session Id",
      "type": "string"
    }
  },
  "required": [
    "upload_session_id",
    "project_id",
    "storage_object_id",
    "backend",
    "object_key",
    "expected_size_bytes",
    "expected_mime_type",
    "mode",
    "creation_idempotency_key",
    "expires_at",
    "audit"
  ],
  "title": "UploadSession",
  "type": "object"
}
