{
  "$id": "urn:ai-automation-force:schema:v1:cost-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "anyOf": [
        {
          "pattern": "^ATT-[0-9]{6,20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "cost_record_id": {
      "pattern": "^CST-[0-9]{6,20}$",
      "title": "Cost Record Id",
      "type": "string"
    },
    "currency": {
      "default": "USD",
      "maxLength": 3,
      "minLength": 3,
      "title": "Currency",
      "type": "string"
    },
    "estimated": {
      "default": false,
      "title": "Estimated",
      "type": "boolean"
    },
    "free_credits_used": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Free Credits Used"
    },
    "job_id": {
      "anyOf": [
        {
          "pattern": "^JOB-[0-9]{6,20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "model_provider_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Provider Id"
    },
    "paid_cost": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Paid Cost"
    },
    "project_id": {
      "pattern": "^PRJ-[0-9]{6,20}$",
      "title": "Project Id",
      "type": "string"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "cost_record_id",
    "project_id",
    "provider_id",
    "model_id",
    "recorded_at"
  ],
  "title": "CostRecord",
  "type": "object"
}
