{
  "$id": "urn:ai-automation-force:schema:v1:qa-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "critical": {
      "default": false,
      "title": "Critical",
      "type": "boolean"
    },
    "findings": {
      "items": {
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "gate": {
      "title": "Gate",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "qa_record_id": {
      "pattern": "^QAR-[0-9]{6,20}$",
      "title": "Qa Record Id",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "subject_id": {
      "title": "Subject Id",
      "type": "string"
    },
    "subject_type": {
      "title": "Subject Type",
      "type": "string"
    }
  },
  "required": [
    "qa_record_id",
    "subject_type",
    "subject_id",
    "gate",
    "passed",
    "created_at"
  ],
  "title": "QARecord",
  "type": "object"
}
